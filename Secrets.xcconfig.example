// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your real values.
// NEVER commit Secrets.xcconfig to version control.
// This template must contain ONLY placeholders — never real keys.
//
// Note: xcconfig does not allow `//` inside values (it's a comment marker).
// URLs must be escaped by inserting `$()` between the slashes:
//   https:/$()/your-project.supabase.co

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_PUBLISHABLE_KEY
// RevenueCat. REVENUECAT_API_KEY ships: the public Apple key (appl_…) from RevenueCat → API keys.
// REVENUECAT_TEST_API_KEY is the Test Store key (test_…), used by Debug builds only so you can
// buy fake subscriptions in the simulator. Release builds ignore it and never accept a test_ key.
REVENUECAT_API_KEY = YOUR_REVENUECAT_PUBLIC_API_KEY
REVENUECAT_TEST_API_KEY =

// PostHog (anonymous usage analytics, EU cloud). Project API keys (phc_…) from each project's
// Settings → General. Debug builds use only POSTHOG_DEBUG_API_KEY (the "Anicca Debug" project) and
// Release builds only POSTHOG_API_KEY (the "Anicca" project). Leave one blank and that build runs
// with analytics switched off.
POSTHOG_API_KEY =
POSTHOG_DEBUG_API_KEY =

// Google Sign-In — leave blank if not yet configured
GOOGLE_CLIENT_ID =
GOOGLE_URL_SCHEME =
