// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your real values.
// NEVER commit Secrets.xcconfig to version control.
// This template must contain ONLY placeholders — never real keys.
//
// Note: xcconfig does not allow `//` inside values (it's a comment marker).
// URLs must be escaped by inserting `$()` between the slashes:
//   https:/$()/your-project.supabase.co

SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_PUBLISHABLE_KEY
REVENUECAT_API_KEY = YOUR_REVENUECAT_PUBLIC_API_KEY

// Google Sign-In — leave blank if not yet configured
GOOGLE_CLIENT_ID =
GOOGLE_URL_SCHEME =
